---
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
const clipId = `logo-${Math.random().toString(36).slice(2, 8)}`;
---

<svg class="logo" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <defs>
    <clipPath id={clipId}><circle cx="12" cy="13" r="8.5"></circle></clipPath>
  </defs>
  <circle cx="20" cy="13" r="8.5" fill="var(--accent)" opacity="0.18"></circle>
  <circle cx="12" cy="13" r="8.5" fill="var(--accent)" opacity="0.18"></circle>
  <circle cx="16" cy="20" r="8.5" fill="var(--accent)" opacity="0.18"></circle>
  <g clip-path={`url(#${clipId})`}>
    <circle cx="20" cy="13" r="8.5" fill="var(--accent)" opacity="0.55"></circle>
  </g>
  <circle cx="12" cy="13" r="8.5" fill="none" stroke="var(--accent)" stroke-width="1.6"></circle>
  <circle cx="20" cy="13" r="8.5" fill="none" stroke="var(--accent)" stroke-width="1.6"></circle>
  <circle cx="16" cy="20" r="8.5" fill="none" stroke="var(--accent)" stroke-width="1.6"></circle>
</svg>
